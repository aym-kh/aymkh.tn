---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Socials from "../components/Socials.astro";
---

<Layout>
  <div class="w-full mx-auto space-y-8 max-w-md">
    <!-- ******************** -->
    <!-- ** HEADSHOT ** -->
    <!-- ******************** -->
    <section
      class="aspect-square overflow-hidden rounded-full w-44 lg:w-56 mx-auto mt-8"
    >
      <img
        src="/profile.webp"
        alt="headshot"
        class="object-cover object-center w-full"
      />
    </section>

    <Nav />
    <Socials />

    <section class="px-4 space-y-4 lg:px-0">
      <div>
        <h1 class="text-3xl font-bold uppercase">aymen khedhriya</h1>
        <p>
          Lead Full Stack Engineer & Independent Consultant, founder of <a
            href="https://maak-corp.tn"
            target="_blank"
            rel="noopener"
            class="underline">MAAK CORP</a
          >
          &nbsp;&&nbsp;
          <a
            href="https://vaga.tn"
            target="_blank"
            rel="noopener"
            class="underline">VAGA ERP</a
          >
        </p>
      </div>
    </section>

    <section class="flex flex-col gap-2 px-4 lg:px-0" id="actions">
      <!-- Resume -->
      <a class="btn" href="/aymen_resume.pdf" target="_blank" rel="noopener">
        <span class="btn-label">
          <svg
            class="btn-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="3" width="20" height="14" rx="2"></rect>
            <path d="M8 21h8M12 17v4"></path>
          </svg>
          Resume
        </span>
        <span class="btn-arrow">→</span>
      </a>

      <!-- Save Contact -->
      <a class="btn" href="#" id="save-contact">
        <span class="btn-label">
          <svg
            class="btn-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          Save Contact
        </span>
        <span class="btn-arrow">↓</span>
      </a>

      <!-- Email -->
      <a class="btn" href="mailto:aymen.khedhriya@gmail.com">
        <span class="btn-label">
          <svg
            class="btn-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          aymen.khedhriya@gmail.com
        </span>
        <span class="btn-arrow">↗</span>
      </a>

      <!-- Phone -->
      <a class="btn" href="tel:+21695593387">
        <span class="btn-label">
          <svg
            class="btn-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.14 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.05 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 17z"
            ></path>
          </svg>
          (+216) 95 593 387
        </span>
        <span class="btn-arrow">↗</span>
      </a>

      <a
        class="btn"
        href="https://cal.com/aymkh/intro"
        target="_blank"
        rel="noopener"
      >
        <span class="btn-label">
          <svg
            class="btn-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M8 2v4"></path>
            <path d="M16 2v4"></path>
            <rect width="18" height="18" x="3" y="4" rx="2"></rect>
            <path d="M3 10h18"></path>
            <path d="m9 16 2 2 4-4"></path>
          </svg>
          Book a Call
        </span>
        <span class="btn-arrow">↗</span>
      </a>
    </section>
  </div>

  <script>
    function downloadVCard(e: Event) {
      e.preventDefault();
      const vcard = [
        "BEGIN:VCARD",
        "VERSION:3.0",
        "FN:Aymen Khedhriya",
        "N:Khedhriya;Aymen;;;",
        "ORG:MAAK CORP LLC",
        "TITLE:Senior Full Stack Engineer",
        "TEL;TYPE=CELL:+21695593387",
        "EMAIL:aymen@maak-corp.tn",
        "URL:https://hire.aymkh.tn",
        "ADR;TYPE=WORK:;;Tunis;;;TN",
        "NOTE:Angular · NestJS · Supabase · PostgreSQL · AI-augmented development",
        "END:VCARD",
      ].join("\n");

      const blob = new Blob([vcard], { type: "text/vcard" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "Aymen_Khedhriya.vcf";
      a.click();
      URL.revokeObjectURL(url);
    }

    document
      .getElementById("save-contact")
      ?.addEventListener("click", downloadVCard);
  </script>
</Layout>
