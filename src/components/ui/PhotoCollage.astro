---
interface Props {
  images: { source: string }[];
}

const { images } = Astro.props;

function getLayoutClasses(count: number) {
  switch (count) {
    case 1:
      return "grid-cols-1";
    case 2:
      return "grid-cols-2";
    case 3:
      return "grid-cols-2 lg:grid-cols-3";
    case 4:
      return "grid-cols-2";
    default:
      return "grid-cols-2 lg:grid-cols-3";
  }
}

function getImageClasses(index: number, count: number) {
  const base =
    "relative overflow-hidden rounded-lg cursor-pointer transition-all duration-300 hover:scale-[1.02] hover:shadow-xl";

  if (count === 3 && index === 0) {
    return `${base} lg:col-span-2 lg:row-span-2 h-[300px] lg:h-[500px]`;
  }
  if (count === 3) {
    return `${base} h-[200px] lg:h-[245px]`;
  }
  if (count === 4) {
    return `${base} h-[250px]`;
  }
  if (count >= 5 && index === 0) {
    return `${base} col-span-2 h-[300px]`;
  }

  return `${base} h-[200px] lg:h-[250px]`;
}
---

{
  images && images.length > 0 && (
    <div class={`grid ${getLayoutClasses(images.length)} gap-4`}>
      {images.map((image, index) => (
        <div
          class={getImageClasses(index, images.length)}
          data-photo-full={image.source}
        >
          <img
            src={image.source}
            alt={`Photo ${index + 1}`}
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  )
}

<script>
  if (!(window as any).__photoLightboxInit) {
    (window as any).__photoLightboxInit = true;

    function getOverlay() {
      let overlay = document.getElementById("photo-lightbox");
      if (!overlay) {
        overlay = document.createElement("div");
        overlay.id = "photo-lightbox";
        overlay.className =
          "fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4 cursor-zoom-out";
        overlay.innerHTML =
          '<img id="photo-lightbox-img" class="max-w-full max-h-full object-contain" alt="Selected photo" />';
        document.body.appendChild(overlay);
      }
      return overlay;
    }

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      const trigger = target.closest("[data-photo-full]") as HTMLElement | null;
      if (trigger) {
        const overlay = getOverlay();
        const img = document.getElementById(
          "photo-lightbox-img",
        ) as HTMLImageElement;
        img.src = trigger.dataset.photoFull!;
        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
        return;
      }

      if (target.closest("#photo-lightbox")) {
        const overlay = document.getElementById("photo-lightbox");
        overlay?.classList.add("hidden");
        overlay?.classList.remove("flex");
      }
    });
  }
</script>
